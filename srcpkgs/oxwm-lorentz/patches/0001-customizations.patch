+/// The leftmost tiled column in the current viewport, ignoring floating clients.
+pub fn leftmostViewportClient(monitor: *Monitor) ?*Client {
+    const step = getScrollStep(monitor);
+    const offset = std.math.clamp(monitor.scroll_offset, 0, getMaxScroll(monitor));
+    const target_index = if (step > 0) @divTrunc(offset, step) else 0;
+    var index: i32 = 0;
+    var current = client_mod.nextTiled(monitor.clients);
+    while (current) |client| : (current = client_mod.nextTiled(client.next)) {
+        if (index == target_index) return client;
+        index += 1;
+    }
+    return null;
+}
