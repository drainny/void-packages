+    const step = getScrollStep(&monitor);
+    monitor.scroll_offset = 2 * step;
+    // The third/fourth columns are already visible: never jump to column one.
+    try std.testing.expectEqual(2 * step, getTargetScrollForWindow(&monitor, &clients[3]));
+    // A newly appended fifth column requires exactly one step to the right.
+    try std.testing.expectEqual(3 * step, getTargetScrollForWindow(&monitor, &clients[4]));
+    // Opening a floating terminal must not reposition existing tiled windows.
+    var floating = Client{ .tags = 1, .monitor = &monitor, .is_floating = true };
+    try std.testing.expectEqual(2 * step, getTargetScrollForWindow(&monitor, &floating));
+}
