+/// Adjacent window on the viewed tags, stopping at either end of the list.
+/// Floating windows retain their place in the focus order.
+pub fn adjacentVisible(monitor: *Monitor, direction: i32) ?*Client {
+    const selected = monitor.sel orelse return null;
+    if (direction == 0) return null;
+    if (direction > 0) {
+        var current = selected.next;
+        while (current) |client| : (current = client.next) {
+            if (isVisible(client)) return client;
+        }
+        return null;
+    }
+    var previous: ?*Client = null;
+    var current = monitor.clients;
+    while (current) |client| : (current = client.next) {
+        if (client == selected) return previous;
+        if (isVisible(client)) previous = client;
+    }
+    return null;
+}
+
+/// Adjacent tiled client on the viewed tags, without wrapping at the ends.
+pub fn adjacentTiled(monitor: *Monitor, direction: i32) ?*Client {
+    const selected = monitor.sel orelse return null;
+    if (direction == 0 or selected.is_floating) return null;
+    if (direction > 0) {
+        var current = selected.next;
+        while (current) |client| : (current = client.next) {
+            if (isVisible(client) and !client.is_floating) return client;
+        }
+        return null;
+    }
+    var previous: ?*Client = null;
+    var current = monitor.clients;
+    while (current) |client| : (current = client.next) {
+        if (client == selected) return previous;
+        if (isVisible(client) and !client.is_floating) previous = client;
+    }
+    return null;
+}
