+/// Insert after the focused client when it belongs to the destination tags.
+pub fn attachAfterSelected(client: *Client) void {
+    const monitor = client.monitor orelse return;
+    if (monitor.sel) |selected| {
+        if (selected.monitor == monitor and isVisibleOnTag(selected, client.tags)) {
+            client.next = selected.next;
+            selected.next = client;
+            return;
+        }
