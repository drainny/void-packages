conflicts="ueberzug>=0"
nostrip=yes
noshlibprovides=yes

do_install() {
	local lib doc docpkg
	vmkdir usr/lib/ueberzugpp/compat
	vinstall usr/bin/ueberzug 755 usr/lib/ueberzugpp
	# Keep older SONAMEs private to this program. XBPS still scans all ELFs
	# and generates dependencies on the remaining Void system libraries.
	for lib in lib/*.so.* usr/lib/*.so.* \
	 lib/x86_64-linux-gnu/*.so.* usr/lib/x86_64-linux-gnu/*.so.*; do
		[ -e "$lib" ] || continue
		vcopy "$lib" usr/lib/ueberzugpp/compat
	done
	vmkdir usr/bin
	cat >"${DESTDIR}/usr/bin/ueberzug" <<'EOF'
#!/bin/sh
export LD_LIBRARY_PATH="/usr/lib/ueberzugpp/compat${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec /usr/lib/ueberzugpp/ueberzug "$@"
EOF
	chmod 755 "${DESTDIR}/usr/bin/ueberzug"
	ln -s ueberzug "${DESTDIR}/usr/bin/ueberzugpp"
	vmkdir usr/share/man
	vcopy usr/share/man/man1 usr/share/man
	vdoc usr/share/doc/ueberzugpp/copyright
	for doc in usr/share/doc/*/copyright; do
		[ "$doc" != usr/share/doc/ueberzugpp/copyright ] || continue
		docpkg=${doc%/copyright}
		vlicense "$doc" "${docpkg##*/}-copyright"
	done
}
