# Template file for 'zig0.16'
pkgname=zig0.16
version=0.16.0
revision=1
archs="x86_64* aarch64*"
short_desc="Zig 0.16 compiler from official upstream binaries"
maintainer="Lorentz <lorentz@localhost>"
license="MIT"
homepage="https://ziglang.org"
nostrip=yes
nodebug=yes
# Upstream's Linux compiler is static; bundled target libraries are not host libs.
noverifyrdeps=yes
lib32disabled=yes
nocross="Official binary toolchain must match the native build architecture"

case "$XBPS_TARGET_MACHINE" in
	x86_64*)
		_zig_arch=x86_64
		checksum=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
		;;
	aarch64*)
		_zig_arch=aarch64
		checksum=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17
		;;
	*) broken="No packaged upstream Zig 0.16 compiler for this architecture" ;;
esac
_distname="zig-${_zig_arch}-linux-${version}"
distfiles="https://ziglang.org/download/${version}/${_distname}.tar.xz"

do_check() {
	test "$(./zig version)" = "$version"
}

do_install() {
	vmkdir usr/lib/zig0.16
	vcopy lib usr/lib/zig0.16
	vinstall zig 755 usr/lib/zig0.16
	vmkdir usr/bin
	ln -s ../lib/zig0.16/zig "${DESTDIR}/usr/bin/zig0.16"
	vlicense LICENSE
	vdoc README.md
}
